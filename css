/* ---------- Переменные ---------- */
:root {
  --primary: #0d47a1;      /* Тёмно-синий */
  --accent: #ff6f00;       /* Оранжевый */
  --bg: #ffffff;
  --bg-alt: #f5f7fa;
  --text: #333333;
  --text-light: #ffffff;
  --font: 'Inter', system-ui, sans-serif;
}

/* ---------- Сброс ---------- */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
html {
  scroll-behavior: smooth;
}
body {
  font-family: var(--font);
  line-height: 1.6;
  color: var(--text);
  background: var(--bg);
}

/* ---------- Утилиты ---------- */
.container {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
}
.section {
  padding: 4rem 0;
}
.alt-bg {
  background: var(--bg-alt);
}
.btn {
  display: inline-block;
  margin-top: 1rem;
  padding: .75rem 1.5rem;
  background: var(--accent);
  color: var(--text-light);
  text-decoration: none;
  border-radius: 6px;
  font-weight: 600;
  transition: background .3s;
}
.btn:hover {
  background: #e65100;
}

/* ---------- Хедер ---------- */
.site-header {
  background: var(--primary);
  color: var(--text-light);
  padding: 1rem 0;
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 2px 6px rgba(0,0,0,.2);
}
.site-header .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text-light);
  text-decoration: none;
}
.nav ul {
  display: flex;
  gap: 1.5rem;
  list-style: none;
}
.nav a {
  color: var(--text-light);
  text-decoration: none;
  font-weight: 500;
  transition: color .2s;
}
.nav a:hover {
  color: var(--accent);
}
.menu-toggle {
  display: none;
  background: none;
  border: none;
  color: var(--text-light);
  font-size: 1.8rem;
  cursor: pointer;
}

/* ---------- Главная ---------- */
.hero {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: var(--text-light);
  text-align: center;
  padding: 6rem 0;
}
.hero h1 {
  font-size: 2.5rem;
  margin-bottom: .5rem;
}
.hero p {
  font-size: 1.125rem;
  max-width: 600px;
  margin: 0 auto 1.5rem;
}

/* ---------- Преимущества ---------- */
.features-grid {
  display: grid;
  gap: 2rem;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  margin-top: 2rem;
}
.feature {
  text-align: center;
  padding: 1.5rem;
  background: var(--bg);
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,.05);
}
.feature .icon {
  font-size: 2rem;
  display: block;
  margin-bottom: .5rem;
}

/* ---------- Услуги ---------- */
.services-list {
  display: grid;
  gap: 1.5rem;
  margin-top: 2rem;
}
.service {
  background: var(--bg);
  padding: 1.5rem;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,.05);
}

/* ---------- Галерея ---------- */
.gallery-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  margin-top: 2rem;
}
.gallery-grid img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  object-fit: cover;
}

/* ---------- Отзывы ---------- */
.testimonials-grid {
  display: grid;
  gap: 2rem;
  margin-top: 2rem;
}
blockquote {
  background: var(--bg);
  padding: 1.5rem;
  border-left: 4px solid var(--accent);
  border-radius: 8px;
}
blockquote footer {
  margin-top: .75rem;
  font-size: .9rem;
  color: #666;
}

/* ---------- Форма контактов ---------- */
.contact-form {
  display: grid;
  gap: 1rem;
  margin-top: 2rem;
  max-width: 600px;
}
.contact-form label {
  font-weight: 600;
}
.contact-form input,
.contact-form textarea {
  padding: .6rem;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-family: inherit;
}
.contact-form button {
  justify-self: start;
}

/* ---------- Футер ---------- */
.site-footer {
  background: var(--primary);
  color: var(--text-light);
  text-align: center;
  padding: 2rem 0;
}
.site-footer .social {
  margin-top: .5rem;
}
.site-footer .social a {
  color: var(--text-light);
  margin: 0 .4rem;
  text-decoration: none;
}

/* ---------- Адаптивность ---------- */
@media (max-width: 768px) {
  .nav {
    position: absolute;
    top: 60px;
    right: 0;
    background: var(--primary);
    width: 200px;
    display: none;
    box-shadow: -2px 2px 8px rgba(0,0,0,.3);
  }
  .nav.open {
    display: block;
  }
  .nav ul {
    flex-direction: column;
    padding: 1rem;
  }
  .menu-toggle {
    display: block;
  }
}
